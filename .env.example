ADMIN_USERNAME=change-me
ADMIN_PASSWORD=use-a-long-unique-password
ADMIN_SESSION_SECRET=use-at-least-32-random-characters

# Hostinger/Node production: keep these outside the deployment/release folder.
# If omitted in production, the app uses $HOME/.zeminyikama automatically.
SHOP_DATA_FILE=/home/hostinger-user/.zeminyikama/shop-store.json
SHOP_UPLOAD_DIR=/home/hostinger-user/.zeminyikama/uploads
